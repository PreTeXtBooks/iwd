    <questionvariables>
      <text><![CDATA[/* Four households; household size and income increase together. */
n1:1;
n2:rand(2)+2;
n3:rand(2)+4;
n4:rand(2)+6;
base:(rand(5)+8)*100;
inc1:base;
inc2:base+200;
inc3:base+400;
inc4:base+800;
nh:4;
ni:n1+n2+n3+n4;
total:inc1+inc2+inc3+inc4;
mean_h:total/nh;
weighted_total:n1*inc1+n2*inc2+n3*inc3+n4*inc4;
mean_i:weighted_total/ni;
/* Integer response codes; the optional third entry is displayed. */
taunit1:random_permutation([[1,true,"One household"],[2,false,"One individual"],[3,false,"One income payment"]]);
taunit2:random_permutation([[1,false,"One household"],[2,true,"One individual"],[3,false,"One income payment"]]);
/* Increasing incomes and household sizes ensure mean_i > mean_h. */
tapredict:random_permutation([[1,false,"The two means will be equal"],[2,true,"The individual-level mean will be higher"],[3,false,"The household-level mean will be higher"],[4,false,"There is not enough information to predict"]]);
tainterpret:random_permutation([[1,true,"The first mean weights households equally; the second weights households according to their numbers of members."],[2,false,"Both means weight households equally."],[3,false,"The individual-level mean is automatically the correct mean because it uses more rows."],[4,false,"Repeating income once for each person does not change its mean."]]);]]></text>
    </questionvariables>
