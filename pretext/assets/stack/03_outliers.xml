    <questionvariables>
      <text><![CDATA[/* Six ordinary ages and one unusually high, but plausible, age.
   All values are sorted for students. */
base:rand(7)+20;
a1:base;
a2:base+2;
a3:base+4;
a4:base+6;
a5:base+8;
a6:base+10;
older:rand(10)+70;

q_mean7:(a1+a2+a3+a4+a5+a6+older)/7;
q_median7:a4;
q_mean6:(a1+a2+a3+a4+a5+a6)/6;
q_median6:(a3+a4)/2;
q_meanincrease:q_mean7-q_mean6;
medianincrease:q_median7-q_median6;

/* The first entry in each radio list is not always displayed first. */
tapredict:random_permutation([
 [1,true,"The mean, because it uses the actual size of every age."],
 [2,false,"The median, because it is always the largest age."],
 [3,false,"Both are necessarily affected by exactly the same amount."],
 [4,false,"Neither, because the unusually high age is still a valid observation."]
]);
tatypical:random_permutation([
 [1,true,"The median of the full dataset."],
 [2,false,"The mean of the full dataset."],
 [3,false,"The oldest farmer's age."],
 [4,false,"The range of the ages."]
]);
taexplain:random_permutation([
 [1,true,"The unusually high age pulls the mean upwards, while the median depends on the middle observation(s)."],
 [2,false,"The median is better because the oldest farmer's age must be an error."],
 [3,false,"The mean ignores the oldest age, so it stays close to the other six ages."],
 [4,false,"The mean and median always give the same description of a dataset."]
]);]]></text>
    </questionvariables>
