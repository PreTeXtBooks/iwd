a:rand(9)+8;
b:rand(3)+1;
c:rand(3)+1;
d:rand(8)+5;
e:rand(8)+4;
allthree:a+b+c;
total:allthree+d+e;
tapredict:random_permutation([
 [1,true,"The first three labels describe the same consumption pattern."],
 [2,false,"The first three labels describe three different patterns."],
 [3,false,"The first three responses should all be deleted."],
 [4,false,"The labels cannot be compared without knowing the respondents' ages."]
]);
tatable:random_permutation([
 [1,true,"All three meals: combined frequency; breakfast only: original frequency; dinner only: original frequency."],
 [2,false,"Keep all five original labels as separate categories."],
 [3,false,"Keep only the first all-three-meals label and discard the other two."],
 [4,false,"Combine breakfast only and dinner only with the all-three-meals category."]
]);
tareason:random_permutation([
 [1,true,"It avoids splitting one consumption pattern across several factor levels."],
 [2,false,"It increases the total number of survey responses."],
 [3,false,"It proves that the respondents entered incorrect meal information."],
 [4,false,"It makes every consumption pattern equally frequent."]
]);]]></text>
