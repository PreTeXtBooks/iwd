            </row>

            <row>
              <cell>2</cell>
              <cell>830</cell>
              <cell>VOI</cell>
              <cell>TAITA/TAVETA</cell>
              <cell>MOMBASA-NAIROBI</cell>
              <cell>IKANGA</cell>
              <cell>HEAD ON COLLISION</cell>
              <cell>M</cell>
              <cell>28</cell>
              <cell>25</cell>
              <cell>M/CYCLIST</cell>
