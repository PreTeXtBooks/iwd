              <cell>The vehicle overtook a M/cycle and lost control</cell>
              <cell>M</cell>
              <cell>A</cell>
              <cell>10</cell>
              <cell>PASSENGER</cell>
              <cell>1</cell>
              <cell>1,421,932</cell>
