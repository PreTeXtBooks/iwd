              <cell>ACCIDENT DETAILS</cell>
              <cell>GENDER</cell>
              <cell>AGE</cell>
              <cell>CAUSE</cell>
              <cell>VICTIM</cell>
              <cell>NO.</cell>
              <cell>Population</cell>
              <cell>Male</cell>
              <cell>Female</cell>
              <cell>Density</cell>
            </row>

            <row>
              <cell>1</cell>
              <cell>630</cell>
              <cell>KITUI</cell>
              <cell>MAKUENI</cell>
              <cell>KITUI-ITHOKWE</cell>
