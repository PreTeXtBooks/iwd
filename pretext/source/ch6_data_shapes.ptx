              <cell>2,162,202</cell>
              <cell>1,077,272</cell>
              <cell>1,084,835</cell>
              <cell>288.11</cell>
            </row>

            <row>
              <cell>5</cell>
              <cell>1900</cell>
              <cell>MATUU</cell>
              <cell>MACHAKOS</cell>
              <cell>MATUU-MWINGI</cell>
