            </row>

            <row>
              <cell>3</cell>
              <cell>1330</cell>
              <cell>MARIAKANI</cell>
              <cell>KILIFI</cell>
              <cell>MOMBASA-NAIROBI</cell>
              <cell>KATOLANI</cell>
              <cell>The unknown M/V hit the motor cycle</cell>
              <cell>M</cell>
              <cell>A &amp; J</cell>
              <cell>98</cell>
              <cell>M/CYCLIST</cell>
              <cell>1</cell>
              <cell>1,453,787</cell>
              <cell>704,089</cell>
              <cell>749,673</cell>
              <cell>115.81</cell>
            </row>

            <row>
              <cell>4</cell>
              <cell>2100</cell>
              <cell>ONGATA RONGAI</cell>
              <cell>NAKURU</cell>
              <cell>NAKURU-NAIROBI</cell>
              <cell>MAASAI LODGE</cell>
              <cell>The vehicle knocked down a pedestrian</cell>
              <cell>M</cell>
              <cell>65</cell>
              <cell>29</cell>
              <cell>PEDESTRIAN</cell>
