            </row>

            <row>
              <cell>2</cell>
              <cell>830</cell>
              <cell>VOI</cell>
              <cell>TAITA/TAVETA</cell>
              <cell>MOMBASA-NAIROBI</cell>
              <cell>IKANGA</cell>
