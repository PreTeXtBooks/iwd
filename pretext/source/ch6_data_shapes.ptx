              <cell>MATUU</cell>
              <cell>MACHAKOS</cell>
              <cell>MATUU-MWINGI</cell>
              <cell>KIVANDINI</cell>
              <cell>
                THE VEHICLE OVERTOOK A M/CYCLE AND LOST CONTROL VEERING OFF THE
                ROAD &amp; ROLLED
              </cell>
              <cell>M</cell>
              <cell>A</cell>
              <cell>10</cell>
              <cell>PASSENGER</cell>
              <cell>1</cell>
              <cell>2016-06-25</cell>
            </row>
          </tabular>
        </table>

        <table xml:id="table-ch6-joined-sample-census">
          <title>
            The same five rows, showing the population columns (from the
            census).
            Row 2 has <c>NA</c> for all census columns because
            <c>TAITA TAVETA</c> did not match.
          </title>

          <tabular halign="left">
            <col halign="right"/>
            <col halign="left"/>
            <col halign="left"/>
            <col halign="left"/>
            <col halign="left"/>
            <col halign="left"/>
            <col halign="left"/>
            <col halign="left"/>
            <col halign="left"/>
            <col halign="left"/>
            <row header="yes" bottom="minor">
              <cell>Row</cell>
              <cell>Population</cell>
              <cell>Male</cell>
