<?xml version="1.0" encoding="utf-8"?>
<!-- This file, the project manifest, provides the overall configuration for your PreTeXt project. To edit the content of your document, open `source/main.ptx`. See https://pretextbook.org/doc/guide/html/processing-CLI.html#cli-project-manifest. -->
<project ptx-version="2">
  <targets>
    <target name="web" format="html" source="main.ptx" publication="publication.ptx" output-dir="web">
      <stringparams html.css.extra="external/custom-styles.css" html.js.extra="external/custom-footer.js"/>
    </target>
    <target name="print" format="pdf" source="main.ptx" publication="publication.ptx" output-dir="print" latex-engine="xelatex" />
    <target name="print-latex" format="latex" source="main.ptx" publication="publication.ptx" output-dir="print-latex" />
    <target name="subset" format="html" source="main.ptx" publication="publication.ptx" output-dir="subset">
      <stringparams debug.skip-knowls="yes" />
    </target>
  </targets>
</project>
